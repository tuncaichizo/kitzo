{
  "name": "kitzo",
  "version": "0.4.6",
  "description": "Kitzo - a tiny desktop buddy with voice commands, shortcuts, crypto mood and reminders",
  "author": "Tunca Ichizo",
  "license": "SEE LICENSE IN LICENSE",
  "main": "main.js",
  "desktopName": "kitzo.desktop",
  "scripts": {
    "start": "electron .",
    "icon": "electron . --export-icon=build/icon.png",
    "dist": "electron-builder --win nsis",
    "characters": "node tools/pixel/build.js",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.kitzo.app",
    "productName": "Kitzo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-marks.js",
      "actions.json",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.tar.gz"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Kitzo-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Kitzo"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Masaustu arkadasi: sesli komutlar, kisayollar, kripto ruh hali ve hatirlaticilar",
      "artifactName": "Kitzo-${version}-${arch}.${ext}",
      "executableName": "kitzo",
      "desktop": {
        "entry": {
          "Name": "Kitzo",
          "Comment": "Masaustu arkadasi",
          "Categories": "Utility;"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "maintainer": "Tunca Ichizo <tuncaichizo@users.noreply.github.com>",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "tar": "^7.5.22",
    "vosk-browser": "^0.0.8"
  }
}
